PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/strologer_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
APP_NAME=Acharya Vedic Astrology Consultations

# Cloudinary (Optional - local storage used if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zoom Server-to-Server OAuth (Optional - manual link fallback used if empty)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# SMTP Email (Optional - in-app notification used if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
